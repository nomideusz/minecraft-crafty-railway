{
	admin off
	# Hides the boot notices ("admin endpoint disabled", "HTTP/2 requires TLS")
	# that Railway shows as warnings; proxy errors still get logged.
	log {
		level ERROR
	}
	servers {
		# TLS ends at Railway's edge; trust its X-Forwarded-For to find the client.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT} {
	# Crafty's login cookie has no Secure flag (it expects to serve HTTPS itself):
	# never send it over plain HTTP, and have browsers skip HTTP altogether.
	header Strict-Transport-Security "max-age=31536000"
	header >Set-Cookie "^(token=.*)$" "$1; Secure; SameSite=Lax"

	reverse_proxy https://127.0.0.1:8443 {
		# Crafty's own self-signed certificate, on a hop that never leaves the container.
		transport http {
			tls_insecure_skip_verify
		}
		# Crafty locks an IP out after 3 wrong passwords: give it the real one,
		# not 127.0.0.1 shared by everyone.
		header_up X-Real-IP {client_ip}
		# For an https upstream Caddy sends Host: 127.0.0.1:8443, and Crafty's
		# websockets (live console, stats) refuse any Origin that doesn't match Host.
		header_up Host {hostport}
	}
}
